# Test PDF parsing function with base64 encoded PDF
POST localhost:8000/run
Content-Type: application/json

{
  "app_name": "multi_tool_agent",
  "user_id": "u_123",
  "session_id": "s_123",
  "new_message": {
    "role": "user",
    "parts": [
      {
        "text": "Please call the parse_pdf function and parse this PDF file with the link parameter and extract the text from it. https://kboo.fm/sites/default/files/28_SHORT_POEMS_&_PROSE_POEMS_by_REVERDY.pdf"
      }
    ]
  }
}
