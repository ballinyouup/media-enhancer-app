POST localhost:8000/run
Content-Type: application/json

{
  "app_name": "multi_tool_agent",
  "user_id": "u_123",
  "session_id": "s_123",
  "new_message": {
    "role": "user",
    "parts": [
      {
        "text": "Hey my name is Bryan."
      }
    ]
  }
}

