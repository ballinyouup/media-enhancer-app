#  -H "Content-Type: application/json"
#  -d '{"state": {"key1": "value1", "key2": 42}}'
POST http://localhost:8000/apps/multi_tool_agent/users/u_123/sessions/s_123
Content-Type: application/json

{
  "state": {
    "key1": "value1",
    "key2": 42
  }
}

